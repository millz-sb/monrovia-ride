# MONROVIA RIDE - Environment Configuration

# Server Port
PORT=3000

# JSON Web Token Secret
JWT_SECRET="monrovia_ride_jwt_secure_secret_2026_liberia"

# Optional PostgreSQL Connection (if using external PostgreSQL instance instead of embedded engine)
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=password
# SQL_DB_NAME=monrovia_ride

# GEMINI_API_KEY: Required if AI capabilities are configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL injected by Cloud Run
APP_URL="MY_APP_URL"
